# Set your own local secrets; generate unique secrets for production.
ENVIRONMENT=development
JWT_SECRET=
# Compose publishes a single-node replica set on localhost; directConnection avoids Docker-only member DNS.
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true
MONGODB_DB=ketsip
CORS_ORIGINS=http://localhost:5173
SEED_ON_STARTUP=true
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=
